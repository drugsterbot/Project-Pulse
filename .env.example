# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/projectpulse"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
# Public base URL, used to build password-reset links. Use https:// in production: it also turns on the Secure flag for the session cookie.
APP_URL="http://localhost:3000"

# --- File storage ---
# "local" stores files in ./uploads. Add an S3/Cloudinary adapter in src/lib/storage.ts to switch.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="15"

# --- AI insights ---
# "mock" is the default deterministic analyzer and needs no key.
# Set to "openai" or "anthropic" and fill the key to enable the adapter placeholder in src/lib/ai/llm-adapter.ts.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
